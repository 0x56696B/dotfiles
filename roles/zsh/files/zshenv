# Platform-independent
export LANG=en_US.UTF-8
export HYPHEN_INSENSITIVE=true
export ENABLE_CORRECTION=true
export XDG_CONFIG_HOME=$HOME/.config
export HIST_STAMPS="dd/mm/yyyy"
export GPG_TTY=$(tty)
export EDITOR="nvim"

# Paths
export GOPATH=$HOME/go
export PATH="$PATH:\
$HOME/.dotnet/tools:\
$DOTNET_ROOT:\
$DOTNET_ROOT/tools:\
$HOME/.local/bin:\
$HOME/.cargo/bin:\
$HOME/.cargo/bin/rustc:\
$HOME/.local/share/JetBrains/Toolbox/scripts:\
$HOME/.bun/bin:\
$GOPATH/bin:"

# Wine
export WINEPREFIX=$HOME/.wine/
export WINEARCH=win64

# Libvirt
export LIBVIRT_DEFAULT_URI='qemu:///session'

# Dotnet
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_ROOT=$HOME/.dotnet

# Tmux
export TMUX_AUTOSTART=true
export TMUX_OVERRIDE_TERM=false

# ZInit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Homebrew
export HOMEBREW_NO_ENV_HINTS='1'
export HOMEBREW_AUTO_UPDATING=0

if command -v brew &> /dev/null
then
  export FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

# Rust
[ -d "$HOME/.cargo/env" ] \
  && source "$HOME/.cargo/env"

# Bitwarden
if [[ `uname` == "Darwin" ]]; then
  export SSH_AUTH_SOCK=/Users/$USER/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock
fi

export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

alias assume=". assume"

# Claude
export ECC_GOVERNANCE_CAPTURE=1 # claude-code-everything: Capture governance events (secrets, policy violations, approval requests)
export CAVEMAN_DEFAULT_MODE=ultra # caveman plugin: always ultra mode

# UV for keyring
export UV_KEYRING_PROVIDER=subprocess
