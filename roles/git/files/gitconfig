[core]
  pager = diff-so-fancy | less --tabs=4 -RF

[interactive]
  diffFilter = diff-so-fancy --patch

[merge]
	conflictstyle = diff3
	tool = vimdiff

[mergetool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$MERGED\" \"$BASE\" \"$REMOTE\" -c \"wincmd w\" -c \"wincmd J\"

[diff]
  colorMoved = default
	tool = nvimdiff

[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\" -c \"wincmd w\" -c \"wincmd L\"

[pager]
  diff = diff-so-fancy | less --tabs=4 -RFXS --pattern '^(Date|added|deleted|modified): '

[alias]
  br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches
  patch = !git --no-pager diff --no-color
	undo = reset HEAD^ —-soft
	sync = !git sync -s
  sync-remote = "!f() { git fetch origin \"$1\":refs/remotes/origin/\"$1\" && git fetch && git reset --hard origin/\"$1\"; }; f"
	tags = tag --sort=creatordate
	sw = switch

[push]
  autoSetupRemote = true

[color]
	ui = true

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[color "diff"]
  meta = 11
  frag = magenta bold
  func = 146 bold
  commit = yellow bold
  old = red bold
  new = green bold
  whitespace = red reverse

[rerere]
	enabled = true
[user]
	signingkey = ~/.ssh/id_rsa.pub
[commit]
	gpgSign = true
[init]
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[tag]
	gpgSign = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@github.com:"]
  pushInsteadOf = "https://github.com/"
